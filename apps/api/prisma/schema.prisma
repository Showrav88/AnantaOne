generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform + tenant roles live in a lookup table (not Postgres enums).
model RoleLookup {
  id          String   @id @default(cuid())
  code        String   @unique
  nameEn      String
  nameBn      String
  scope       String // platform | tenant
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

/// Product units live in a lookup table (not Postgres enums).
model UnitLookup {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameBn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  locale      String   @default("bn")
  phone       String?
  address     String?
  tagline     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches Branch[]
  users    User[]
  buyers   Buyer[]
  products Product[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users   User[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  /// Null only for SUPER_ADMIN (SaaS platform owner).
  tenantId     String?
  branchId     String?
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  company       Company?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role          RoleLookup     @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([branchId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Buyer {
  id        String   @id @default(cuid())
  tenantId  String
  shopName  String
  phone     String
  address   String?
  locale    String   @default("bn")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  nameBn      String?
  sku         String
  category    String   @default("water")
  unitId      String
  priceBdt    Decimal  @db.Decimal(12, 2)
  stockQty    Decimal  @default(0) @db.Decimal(12, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  company Company    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit    UnitLookup @relation(fields: [unitId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([unitId])
}
