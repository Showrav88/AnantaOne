generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform + tenant roles live in a lookup table (not Postgres enums).
model RoleLookup {
  id          String   @id @default(cuid())
  code        String   @unique
  nameEn      String
  nameBn      String
  scope       String // platform | tenant
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

/// Product units live in a lookup table (not Postgres enums).
model UnitLookup {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameBn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  locale      String   @default("bn")
  phone       String?
  address     String?
  tagline     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches           Branch[]
  users              User[]
  buyers             Buyer[]
  products           Product[]
  cashWallet         CashWallet?
  cashTransactions   CashTransaction[]
  salaryPayments     SalaryPayment[]
  sales              Sale[]
  materialPurchases  MaterialPurchase[]
  productionBatches  ProductionBatch[]
  salesOrders        SalesOrder[]
  tagTemplates       TagTemplate[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users   User[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  /// Null only for SUPER_ADMIN (SaaS platform owner).
  tenantId     String?
  branchId     String?
  email        String    @unique
  phone        String?
  name         String
  passwordHash String
  roleId       String
  /// Staff HR fields (managers / employees).
  employeeCode String?
  designation  String?
  joiningDate  DateTime?
  salaryBdt    Decimal?  @db.Decimal(12, 2)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  company        Company?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role           RoleLookup       @relation(fields: [roleId], references: [id])
  refreshTokens  RefreshToken[]
  salaryPayments SalaryPayment[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([branchId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Buyer {
  id        String   @id @default(cuid())
  tenantId  String
  shopName  String
  phone     String
  address   String?
  locale    String   @default("bn")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  nameBn      String?
  sku         String
  category    String   @default("water")
  unitId      String
  priceBdt    Decimal  @db.Decimal(12, 2)
  stockQty    Decimal  @default(0) @db.Decimal(12, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  company  Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     UnitLookup        @relation(fields: [unitId], references: [id])
  batches  ProductionBatch[]
  orderLines OrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([unitId])
}

/// Order intake channel (phone / online / walk-in / counter).
model OrderSourceLookup {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameBn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SalesOrder[]
}

model OrderStatusLookup {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameBn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SalesOrder[]
}

/// One production run of a SKU — FEFO sell allocates from here.
model ProductionBatch {
  id             String    @id @default(cuid())
  tenantId       String
  productId      String
  batchCode      String
  manufacturedAt DateTime
  expiresAt      DateTime?
  qtyProduced    Decimal   @db.Decimal(12, 2)
  qtyRemaining   Decimal   @db.Decimal(12, 2)
  note           String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?

  company    Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@unique([tenantId, batchCode])
  @@index([tenantId, productId])
  @@index([productId, expiresAt])
}

/// B2B / counter sales order — phone, online, or walk-in basket.
model SalesOrder {
  id             String    @id @default(cuid())
  tenantId       String
  /// Stable printable / QR-searchable invoice code (unique per company).
  invoiceCode    String
  buyerId        String?
  buyerName      String?
  sourceId       String
  statusId       String
  totalBdt       Decimal   @default(0) @db.Decimal(14, 2)
  note           String?
  orderedAt      DateTime  @default(now())
  confirmedAt    DateTime?
  saleId         String?   @unique
  reverseReason  String?
  reversedAt     DateTime?
  reversedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  company Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer   Buyer?            @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  source  OrderSourceLookup @relation(fields: [sourceId], references: [id])
  status  OrderStatusLookup @relation(fields: [statusId], references: [id])
  sale    Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  lines   OrderLine[]

  @@unique([tenantId, invoiceCode])
  @@index([tenantId, orderedAt])
  @@index([statusId])
  @@index([sourceId])
  @@index([invoiceCode])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  batchId        String
  qty            Decimal @db.Decimal(12, 2)
  /// Catalog list price at the moment of sale (reference).
  catalogPriceBdt Decimal @db.Decimal(12, 2)
  /// Actual unit price charged (may differ from catalog).
  unitPriceBdt   Decimal @db.Decimal(12, 2)
  lineTotalBdt   Decimal @db.Decimal(14, 2)

  order   SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  batch   ProductionBatch @relation(fields: [batchId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([batchId])
}

/// Printable product tag layout — size + which fields appear.
model TagTemplate {
  id               String  @id @default(cuid())
  tenantId         String
  name             String
  widthMm          Int     @default(50)
  heightMm         Int     @default(30)
  showSku          Boolean @default(true)
  showPrice        Boolean @default(true)
  showDescription  Boolean @default(true)
  showMfgDate      Boolean @default(true)
  showExpDate      Boolean @default(true)
  showBatch        Boolean @default(true)
  showQr           Boolean @default(true)
  showCompany      Boolean @default(true)
  /// Extra text always printed on the tag (independent of catalog).
  tagDescription   String?
  isDefault        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wallet transaction kinds (credit = money in, debit = money out).
model WalletTxnTypeLookup {
  id          String   @id @default(cuid())
  code        String   @unique
  nameEn      String
  nameBn      String
  /// credit | debit
  direction   String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CashTransaction[]
}

/// Company cash drawer / wallet — one per tenant.
model CashWallet {
  id         String   @id @default(cuid())
  tenantId   String   @unique
  balanceBdt Decimal  @default(0) @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company      Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]
}

/// Full cash ledger — every credit (sale) and debit (materials, salary, etc.).
model CashTransaction {
  id           String   @id @default(cuid())
  tenantId     String
  walletId     String
  typeId       String
  amountBdt    Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 2)
  note         String?
  reference    String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  company           Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet            CashWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTxnTypeLookup  @relation(fields: [typeId], references: [id])
  salaryPayment     SalaryPayment?
  sale              Sale?
  materialPurchase  MaterialPurchase?

  @@index([tenantId, occurredAt])
  @@index([walletId])
  @@index([typeId])
}

model SalaryPayment {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  amountBdt         Decimal  @db.Decimal(12, 2)
  periodLabel       String?
  note              String?
  paidAt            DateTime @default(now())
  cashTransactionId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  company         Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([userId])
}

/// Sale cash-in — credits the company wallet after sell.
model Sale {
  id                String   @id @default(cuid())
  tenantId          String
  buyerId           String?
  buyerName         String?
  amountBdt         Decimal  @db.Decimal(14, 2)
  note              String?
  soldAt            DateTime @default(now())
  cashTransactionId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  company         Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder?

  @@index([tenantId, soldAt])
}

/// Material / supply purchase — debits the company wallet.
model MaterialPurchase {
  id                String   @id @default(cuid())
  tenantId          String
  supplierName      String?
  materialName      String
  amountBdt         Decimal  @db.Decimal(14, 2)
  note              String?
  purchasedAt       DateTime @default(now())
  cashTransactionId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  company         Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchasedAt])
}
