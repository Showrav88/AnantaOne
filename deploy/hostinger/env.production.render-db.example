# Hostinger VPS + Render Postgres (same DB as Render app)
# Copy to /var/www/anantaone/.env on VPS — never commit.

NODE_ENV=production
PORT=5000

# MUST match how users open the site (IP now, domain later) — NOT the Render URL
APP_URL=http://31.97.50.25
API_URL=http://31.97.50.25

# Empty = nginx proxies /api on same IP
VITE_API_URL=

# Copy from Render Web Service env (External Database URL, no quotes)
DATABASE_URL=postgresql://USER:PASS@dpg-xxxxx-a.singapore-postgres.render.com/anantaonerender?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASS@dpg-xxxxx-a.singapore-postgres.render.com/anantaonerender?sslmode=require

# Copy from Render Web Service env
JWT_SECRET=
JWT_REFRESH_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional — only if Render had it
# CORS_ORIGINS=

# NODE_VERSION is for Render builds only — not needed on VPS
