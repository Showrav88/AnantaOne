# Copy on VPS to /var/www/anantaone/.env
# Never commit the real .env file.

NODE_ENV=production
PORT=5000

# Your public site URL (https after certbot)
APP_URL=https://YOUR_DOMAIN
API_URL=https://YOUR_DOMAIN

# Leave empty when nginx proxies /api on the same domain (recommended)
VITE_API_URL=

# Local Postgres on VPS (PostgreSQL 18)
DATABASE_URL=postgresql://anantaone:CHANGE_STRONG_PASSWORD@127.0.0.1:5432/anantaone
DIRECT_DATABASE_URL=postgresql://anantaone:CHANGE_STRONG_PASSWORD@127.0.0.1:5432/anantaone

# Auth — generate long random strings (openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe-Strong-Password-2026

# Cloudinary (tenant logos / product images)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional
REDIS_URL=
CORS_ORIGINS=
