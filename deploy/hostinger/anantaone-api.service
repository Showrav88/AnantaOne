[Unit]
Description=AnantaOne API (Node.js)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/anantaone
# Node 26 reads .env directly (systemd EnvironmentFile breaks on some values)
ExecStart=/usr/bin/node --env-file=/var/www/anantaone/.env apps/api/dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
