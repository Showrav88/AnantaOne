{
  "name": "anantaone",
  "version": "0.1.0",
  "private": true,
  "description": "AnantaOne — PERN SaaS for distilled water production (Bangladesh)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run db:generate -w @anantaone/api",
    "db:migrate": "npm run db:migrate -w @anantaone/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @anantaone/api",
    "db:seed": "npm run db:seed -w @anantaone/api",
    "db:studio": "npm run db:studio -w @anantaone/api",
    "render:api:build": "node -e \"if(!process.env.DATABASE_URL&&!process.env.DIRECT_DATABASE_URL){console.error('Missing DATABASE_URL / DIRECT_DATABASE_URL on Render Environment');process.exit(1)} console.log('DB env: set')\" && npm run db:generate -w @anantaone/api && npm run db:migrate:deploy -w @anantaone/api",
    "render:api:start": "npm exec -w @anantaone/api -- tsx src/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true
  }
}
