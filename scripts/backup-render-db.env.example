# Copy this file to backup-render-db.env (same folder) on your Windows PC.
# backup-render-db.env is gitignored — never commit it.
#
# Render external Postgres URL (Dashboard → Database → External connection string).
# sslmode=require is required for Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional overrides (defaults shown)
# BACKUP_DIR=%USERPROFILE%\AnantaOne\backups\postgres
# RETENTION_DAYS=30
# BACKUP_LABEL=anantaone_render
